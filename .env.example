# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will NOT be committed

# --- Firebase Client SDK (frontend) ---
# These are safe to expose in frontend code; security comes from Firestore rules
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- API Backend URL ---
# In development (with `npm run dev`), leave empty — Vite proxies /api to localhost:3001
# In production, set to your Cloud Run service URL (no trailing slash)
# Example: https://kidtracker-api-abc123-ew.a.run.app
VITE_API_BASE_URL=

# --- Backend (server.ts) ---
GEMINI_API_KEY=
# Allowed CORS origin — set to your Firebase Hosting URL in production
# Example: https://kidcare-17eba.web.app
ALLOWED_ORIGIN=http://localhost:5173
PORT=3001
