{
  "name": "kidcare-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --env-file=.env.local --import tsx/esm server.ts",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node_modules/.bin/tsx server.ts"
  },
  "dependencies": {
    "@google/genai": "^1.31.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "firebase": "^12.6.0",
    "firebase-admin": "^12.7.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
